<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btnMessage1_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnTextMessage1_main"
                android:layout_marginTop="20dp"/>

            <Button
                android:id="@+id/btnMessage2_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnTextMessage2_main"
                android:layout_marginTop="20dp"/>

            <Button
                android:id="@+id/btnOpenScreen_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnTextOpenScreen_main"
                android:layout_marginTop="20dp"/>

            <Button
                android:id="@+id/btnTask_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnTextTask_main"
                android:layout_marginTop="20dp"/>

            <Button
                android:id="@+id/btnTaskList_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnTextTaskList_main"
                android:layout_marginTop="20dp"/>

            <Button
                android:id="@+id/btnStats_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estadísticas de tareas"
                android:layout_marginTop="20dp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
