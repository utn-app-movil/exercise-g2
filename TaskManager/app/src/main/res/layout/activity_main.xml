<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnMessage1_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btnTextMessage1_main"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnMessage2_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btnTextMessage2_main"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnOpenScreen_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btnTextOpenScreen_main"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnTask_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btnTextTask_main"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnTaskList_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btnTextTaskList_main"
            android:layout_marginBottom="15dp"/>

        <Button
            android:id="@+id/btnTaskStats_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stats_menu_button"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

