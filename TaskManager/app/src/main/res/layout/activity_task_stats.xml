<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stats_total_label"
            android:textSize="20sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvTotalTasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stats_number_default"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_pending"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/tvPending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_number_default"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_in_progress"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/tvInProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_number_default"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_completed"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/tvCompleted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_number_default"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_cancelled"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/tvCancelled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_number_default"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_percentage_label"
            android:textSize="18sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvPercentage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_number_default"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>

        <ProgressBar
            android:id="@+id/progressCompleted"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="35dp"/>

        <Button
            android:id="@+id/btnBackMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stats_back_main"/>

    </LinearLayout>
</ScrollView>
