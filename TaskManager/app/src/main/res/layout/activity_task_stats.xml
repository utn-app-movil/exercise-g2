<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estadísticas de tareas"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp"/>

    <TextView
        android:id="@+id/txtTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total de tareas: 0"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="25dp"/>

    <TextView
        android:id="@+id/txtPendientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pendientes: 0"
        android:textSize="18sp"
        android:layout_marginBottom="15dp"/>

    <TextView
        android:id="@+id/txtEnProgreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="En progreso: 0"
        android:textSize="18sp"
        android:layout_marginBottom="15dp"/>

    <TextView
        android:id="@+id/txtCompletadas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Completadas: 0"
        android:textSize="18sp"
        android:layout_marginBottom="15dp"/>

    <TextView
        android:id="@+id/txtCanceladas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Canceladas: 0"
        android:textSize="18sp"
        android:layout_marginBottom="30dp"/>

    <TextView
        android:id="@+id/txtPorcentaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tareas completadas: 0%"
        android:textSize="18sp"
        android:layout_marginBottom="10dp"/>

    <ProgressBar
        android:id="@+id/progressTareas"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver al menú principal"/>

</LinearLayout>
